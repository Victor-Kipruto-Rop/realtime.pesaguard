# Local development only. Never commit real secrets.
PORT=4000
PHX_SERVER=true
PHX_HOST=localhost
SECRET_KEY_BASE=
# Event ingest stays disabled until Phase 4 event contracts and routing are approved.
PESAGUARD_EVENT_INGEST_ENABLED=false
PESAGUARD_EVENT_INGEST_TOKEN=
PESAGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Canonical Python API validates JWT signature, key rotation, sessions and account state.
PESAGUARD_AUTH_VALIDATION_URL=https://api.pesaguard.co.ke/auth/verify
# Kafka/Redpanda integration is intentionally not enabled until event contracts are confirmed.
KAFKA_BROKERS=
KAFKA_TOPIC=
