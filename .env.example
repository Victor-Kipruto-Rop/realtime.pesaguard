# Local development only. Never commit real secrets.
PORT=4000
PHX_SERVER=true
PHX_HOST=localhost
SECRET_KEY_BASE=
PESAGUARD_EVENT_INGEST_ENABLED=false
PESAGUARD_EVENT_INGEST_TOKEN=
PESAGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Canonical Python API validates access-token signature, sessions and account state.
PESAGUARD_AUTH_VALIDATION_URL=http://dashboard_api:5001/auth/verify
# Local Docker network: Redpanda service name and internal listener.
KAFKA_BROKERS=redpanda:9092
PESAGUARD_EVENT_CONSUMER_ENABLED=true
PESAGUARD_REALTIME_CONSUMER_GROUP=pesaguard-realtime-gateway-v1
# Keep this list aligned with the approved API event topics and gateway allow-list.
PESAGUARD_REALTIME_EVENT_TOPICS=pesaguard.transactions.failed,pesaguard.transactions.rejected,pesaguard.fraud.analysis
